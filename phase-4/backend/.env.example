# Phase 4 Backend Environment Variables

# Database (Neon PostgreSQL connection)
DATABASE_URL=postgresql+asyncpg://user:password@your-neon-host.neon.tech/dbname

# Authentication (MUST match frontend secret for JWT compatibility)
BETTER_AUTH_SECRET=your-auth-secret-here

# AI Integration (Groq - replaces Gemini)
GROQ_API_KEY=gsk_your-groq-api-key-here

# Google Gemini (deprecated, kept for reference)
GOOGLE_API_KEY=your-google-api-key-here

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Application Settings
APP_ENV=development
LOG_LEVEL=INFO
